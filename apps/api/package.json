{
  "name": "@foka-vote/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --ext .ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "admin:hash-password": "tsx src/scripts/hash-password.ts"
  },
  "dependencies": {
    "@foka-vote/shared": "file:../../packages/shared",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "multer": "^2.4.0",
    "prisma": "^7.10.1",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.3.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  }
}
